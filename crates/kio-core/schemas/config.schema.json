{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "object",
      "properties": {
        "participates_in_global_search": { "type": "boolean" },
        "index_vcs_repos": { "type": "boolean" },
        "ignore": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "additionalProperties": false
    },
    "generated_parent_policy": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "pattern": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "negated": { "type": "boolean" },
              "scope_prefix": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "required": ["pattern", "negated", "scope_prefix"],
            "additionalProperties": false
          }
        }
      },
      "required": ["rules"],
      "additionalProperties": false
    },
    "chunking": {
      "type": "object",
      "properties": {
        "strategy": { "type": "string", "enum": ["heading"] },
        "max_chars": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": ["auto", "text", "vector", "hybrid"]
        },
        "related_images_min_area_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fail_behavior": {
          "type": "string",
          "enum": ["fallback", "error", "warn"]
        },
        "rrf": {
          "type": "object",
          "properties": {
            "k": { "type": "integer", "minimum": 1 },
            "w_text": { "type": "number", "minimum": 0 },
            "w_vector": { "type": "number", "minimum": 0 },
            "candidate_depth": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "diversify": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "strategy": {
              "type": "string",
              "enum": ["mmr", "group_by_raw_hash", "off"]
            },
            "mmr_lambda": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_per_raw_hash": { "type": "integer", "minimum": 0 },
            "mmr_depth": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "multi_scope": {
          "type": "object",
          "properties": {
            "parallelism": { "type": "integer", "minimum": 1, "maximum": 4 },
            "per_scope_timeout_seconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "monthly_usd_cap": { "type": "number", "minimum": 0 },
        "warn_at_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "hard_stop": { "type": "boolean" },
        "per_adapter": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "gc": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["manual_only", "after_index", "on_idle"]
        },
        "idle_threshold_seconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "max_runtime_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "auto_retention": {
          "type": "object",
          "properties": {
            "keep_last_hours": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "keep_hourly_days": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "keep_daily_weeks": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "keep_weekly_months": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          },
          "additionalProperties": false
        },
        "derived_retention": {
          "type": "object",
          "properties": {
            "keep_repaired": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "manual_only" } } },
          "then": { "not": { "anyOf": [ { "required": ["max_runtime_seconds"] }, { "required": ["idle_threshold_seconds"] } ] } }
        },
        {
          "if": { "properties": { "mode": { "const": "after_index" } } },
          "then": { "required": ["max_runtime_seconds"], "not": { "required": ["idle_threshold_seconds"] } }
        },
        {
          "if": { "properties": { "mode": { "const": "on_idle" } } },
          "then": { "required": ["max_runtime_seconds", "idle_threshold_seconds"] }
        }
      ],
      "required": ["mode"]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval_seconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
            "on_change_threshold": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          },
          "required": ["enabled", "interval_seconds", "on_change_threshold"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
      },
      "additionalProperties": false
    },
    "markdownize": {
      "type": "object",
      "properties": {
        "incremental": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_consecutive": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "bbox_annotation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "enum": ["batch", "realtime"]
        },
        "policy": {
          "type": "object",
          "properties": {
            "allow_network": { "type": "boolean" },
            "allowed_scope": { "type": "string" },
            "max_input_bytes": { "type": "integer", "minimum": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "redact_logs": { "type": "boolean" },
            "store_request_body": { "type": "boolean" },
            "store_response_body": { "type": "boolean" },
            "require_command_confirmation": { "type": "boolean" },
            "online_api": {
              "type": "object",
              "properties": {
                "timeout_seconds": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "offline_api": {
              "type": "object",
              "properties": {
                "timeout_seconds": { "type": "integer", "minimum": 1 },
                "ca_pem_path": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "deterministic_library": {
              "type": "object",
              "properties": {
                "timeout_seconds": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
