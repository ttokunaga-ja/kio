{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["kio_format_version", "scope_id"],
  "properties": {
    "kio_format_version": {
      "type": "string",
      "const": "3.0.0"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "scope_path": { "type": "string", "minLength": 1 },
    "scan_approval": {
      "type": "object",
      "description": "QA5 (step4b-contract-tests-p3a.md §B, 10 §1 L97-113): the one-time scope-level scan approval record, distinct from the adapter-level network opt-in (`approvals[]`).",
      "properties": {
        "scope_id": { "type": "string" },
        "root_path": { "type": "string" },
        "approved_at": { "type": "string" },
        "actor": { "type": "string" },
        "approval_method": { "type": "string", "enum": ["interactive", "approve", "yes"] },
        "kio_version": { "type": "string" },
        "effective_ignore_hash": { "type": "string" },
        "estimated_file_count": { "type": "integer", "minimum": 0 },
        "estimated_total_bytes": { "type": "integer", "minimum": 0 },
        "estimated_markdownize_usd": { "type": "number", "minimum": 0 },
        "estimated_embedding_usd": { "type": "number", "minimum": 0 }
      },
      "required": [
        "scope_id",
        "root_path",
        "approved_at",
        "actor",
        "approval_method",
        "kio_version",
        "effective_ignore_hash",
        "estimated_file_count",
        "estimated_total_bytes",
        "estimated_markdownize_usd",
        "estimated_embedding_usd"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "type": "array",
      "description": "QA21-27 (step4b-contract-tests-p3a.md §G/§H, 07 §3 L148-168): adapter-level network opt-in rows, distinct from `scan_approval`. One row per (scope_id, tool_id); revoke/invalidation updates `status` in place (rows are never deleted, for audit).",
      "items": {
        "type": "object",
        "properties": {
          "scope_id": { "type": "string" },
          "tool_id": { "type": "string", "minLength": 1 },
          "execution_mode": { "type": "string" },
          "tool_profile_hash": { "type": "string" },
          "grant_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "secrets_grant_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "approved_at": { "type": "string" },
          "approval_method": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "revoked"] },
          "revoked_at": { "type": "string" }
        },
        "required": [
          "scope_id",
          "tool_id",
          "execution_mode",
          "tool_profile_hash",
          "approved_at",
          "approval_method",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "revoked" } },
              "required": ["status"]
            },
            "then": { "required": ["revoked_at"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "approval_pending": {
      "type": "object",
      "description": "QA21/25-27 (07 §3 L191-205): the single in-flight approval write-order's pending intent (a single object, not an array — approval operations are serialized under `.kio/.lock`).",
      "properties": {
        "scope_id": { "type": "string" },
        "tool_id": { "type": "string", "minLength": 1 },
        "execution_mode": { "type": "string" },
        "tool_profile_hash": { "type": "string" },
          "grant_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "secrets_grant_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "approved_at": { "type": "string" },
        "approval_method": { "type": "string" }
      },
      "required": ["scope_id", "tool_id", "execution_mode", "tool_profile_hash", "approved_at", "approval_method"],
      "additionalProperties": false
    },
    "approvals_initialized": {
      "type": "boolean",
      "description": "QA21/25-27 (07 §3 L176-205): consumed-marker for the one-time 'initial materialize' exception — set true in the same atomic write as the scope's first approval row publish (explicit or materialized), or as a revoke/self-heal-cleanup that actually removed a pending / revoked a row. `true` with `approvals` empty means the exception is already consumed (fail-closed for blanket auto-materialize), not a fresh scope."
    }
  },
  "additionalProperties": false
}
