#!/bin/bash -p
# Privileged mode ignores BASH_ENV and imported functions before clearing Docker's environment.
set -euo pipefail
export LC_ALL=C

configured_socket() {
  local config=$1 socket extra size endpoint parent mode
  [[ -f $config && ! -L $config ]] || return 1
  {
    [[ $(/usr/bin/stat -Lc '%u:%a' /proc/self/fd/3) == 0:600 ]] || return 1
    size=$(/usr/bin/stat -Lc '%s' /proc/self/fd/3) || return 1
    [[ $size -lt 109 ]] || return 1
    IFS= read -r socket <&3 || return 1
    if IFS= read -r extra <&3 || [[ -n $extra ]]; then return 1; fi
  } 3< "$config"
  [[ $socket =~ ^/[A-Za-z0-9_./-]+$ && $size == "$((${#socket} + 1))" && -S $socket ]] || return 1
  endpoint=$(/usr/bin/realpath -e -- "$socket") || return 1
  [[ $endpoint == "$socket" && $endpoint != //* ]] || return 1
  mode=$(/usr/bin/stat -c '%u:%a' -- "$socket") || return 1
  [[ $mode == 0:* ]] && (( (8#${mode#*:} & 002) == 0 )) || return 1
  parent=${socket%/*}
  while [[ -n $parent ]]; do
    mode=$(/usr/bin/stat -c '%u:%a' -- "$parent") || return 1
    [[ $mode == 0:* ]] && (( (8#${mode#*:} & 022) == 0 )) || return 1
    parent=${parent%/*}
  done
  printf '%s\n' "$socket"
}

docker_query() {
  local socket=$1 remaining=$((20 - SECONDS))
  shift
  (( remaining > 0 )) || return 1
  if (( remaining > 4 )); then remaining=4; fi
  /usr/bin/env -i LC_ALL=C PATH=/usr/bin:/bin /usr/bin/timeout -k 1 "$remaining" \
    /opt/kio-v1-local/docker/docker --config /etc/kio-v1-local-shared-gpu-cli \
    --host "unix://$socket" container "$@"
}

running_requests() {
  local socket=$1 ids id result count=0
  ids=$(docker_query "$socket" ls --quiet --no-trunc) || return 1
  if [[ -n $ids ]]; then
    while IFS= read -r id; do
      [[ $id =~ ^[0-9a-f]{64}$ ]] || return 1
      result=$(docker_query "$socket" inspect --format \
        '{{if and .State.Running .HostConfig.DeviceRequests}}1{{else}}0{{end}}' "$id") || return 1
      case $result in
        1) count=$((count + 1)) ;;
        0) ;;
        *) return 1 ;;
      esac
    done <<< "$ids"
  fi
  printf '%s\n' "$count"
}

main() {
  [[ $# == 0 && $EUID == 0 ]] || return 1
  cd /
  SECONDS=0
  local socket count
  if socket=$(configured_socket /etc/kio-v1-local-shared-gpu-socket 2>/dev/null) &&
    count=$(running_requests "$socket" 2>/dev/null); then
    printf '%s\n' "$count"
  else
    printf '%s\n' 'shared Docker GPU query failed' >&2
    return 1
  fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
