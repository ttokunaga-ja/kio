#!/usr/bin/python3 -I
"""Report the running shared Engine containers with Docker device requests."""
import http.client
import json
import os
import re
import signal
import socket
import stat
import sys

CONFIG = "/etc/kio-v1-local-shared-gpu-socket"
MAX_RESPONSE = 8 * 1024 * 1024


class Engine(http.client.HTTPConnection):
    def __init__(self, endpoint, **kwargs):
        super().__init__("localhost", **kwargs)
        self.endpoint = endpoint

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.endpoint)

    def read_json(self, path):
        self.request("GET", path)
        with self.getresponse() as response:
            if response.status != 200:
                raise ValueError("Docker query failed")
            body = response.read(MAX_RESPONSE + 1)
        if len(body) > MAX_RESPONSE:
            raise ValueError("Docker response exceeded limit")
        return json.loads(body)


def running_requests(engine):
    count = 0
    for entry in engine.read_json("/containers/json"):
        container = entry["Id"]
        if not re.fullmatch(r"[0-9a-f]{64}", container):
            raise ValueError("invalid Docker container ID")
        state = engine.read_json(f"/containers/{container}/json")
        running = state["State"]["Running"]
        requests = state["HostConfig"]["DeviceRequests"]
        if not isinstance(running, bool) or (requests is not None and not isinstance(requests, list)):
            raise ValueError("invalid Docker response")
        # The original admission check treated any DeviceRequests as GPU use.
        count += int(running and bool(requests))
    return count


def configured_socket(config):
    fd = os.open(config, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
            raise ValueError("unsafe shared Docker configuration")
        raw = handle.read(109)
    if not re.fullmatch(rb"/[A-Za-z0-9_./-]+\n", raw) or len(raw) > 108:
        raise ValueError("invalid shared Docker endpoint")
    path = os.fsdecode(raw[:-1])
    if path != os.path.normpath(path) or path.startswith("//"):
        raise ValueError("shared Docker endpoint is not canonical")
    endpoint = os.lstat(path)
    if not stat.S_ISSOCK(endpoint.st_mode) or endpoint.st_uid != 0 or endpoint.st_mode & 0o002:
        raise ValueError("unsafe shared Docker socket")
    parent = os.path.dirname(path)
    while parent != "/":
        info = os.lstat(parent)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError("unsafe shared Docker socket ancestry")
        parent = os.path.dirname(parent)
    return path


def main():
    if len(sys.argv) != 1 or os.geteuid() != 0:
        return 1
    signal.alarm(20)
    try:
        engine = Engine(configured_socket(CONFIG), timeout=4)
        try:
            count = running_requests(engine)
        finally:
            engine.close()
        print(count)
        return 0
    except (OSError, ValueError, TypeError, KeyError, http.client.HTTPException):
        print("shared Docker GPU query failed", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
